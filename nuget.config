<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Rethink-Common" value="https://rethinkfirst.pkgs.visualstudio.com/RethinkFirst/_packaging/Rethink-Common/nuget/v3/index.json" />
    <add key="Rethink-BH" value="https://rethinkfirst.pkgs.visualstudio.com/RethinkFirst/_packaging/RethinkBHFeed/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Rethink-Common">
      <package pattern="RethinkCore.*" />
    </packageSource>
    <packageSource key="Rethink-BH">
      <package pattern="Rethink.BH.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
