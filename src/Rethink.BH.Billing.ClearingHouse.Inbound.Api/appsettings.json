{
  "KeyVaultUri": "https://bai-ch-eus2-dev-kv.vault.azure.net/",
  "Logging": {
    "AppInsightsLogger": {
      "IsEnabled": true,
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Error",
        "System": "Warning",
        "Rethink": "Information"
      }
    }
  },
  "ApplicationInsights": {
    "InstrumentationKey": "Dev--Clearinghouse--ApplicationInsights--InstrumentationKey",
    "APPLICATIONINSIGHTS_CONNECTION_STRING": "Dev--Billing--ApplicationInsights--Connection--String"
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "ApplicationKeySettings": {
      "CheckAcceptedApplicationKeys": false
    }
  },
  "BillingApiUrl": "Dev--Clearinghouse--BillingApiUrl",
  "BillingApiKey": "Dev--Clearinghouse--BillingApiKey",
  "HeaderKey": "x-application-key",
  "ConnectionStrings": {
    "BlobStorage": {
      "ConnectionString": "Dev--Clearinghouse--ConnectionStrings--BlobStorage--ConnectionString"
    },
    "InboundManifest": "Dev--Clearinghouse--ConnectionStrings--InboundManifest"
  },
  "AvailityBackup": "billing-availity-backup",
  "Pipeline": {
    "Mode": "Off",
    "Role": "Api",
    "ClearingHouseIds": [ 1, 8 ],
    "MinimumFileAgeSeconds": 120,
    "DownloadConcurrency": 4,
    "ProcessConcurrency": 4,
    "MaxAttempts": 5,
    "RetryBaseDelaySeconds": 30,
    "RetryMaxDelaySeconds": 1800,
    "ClaimTimeoutMinutes": 30,
    "StalledAfterMinutes": 120,
    "StalledBatchSize": 500,
    "Landing": {
      "ContainerName": "inbound-landing",
      "BlockSizeKiB": 4096,
      "LeaseSeconds": 60
    },
    "Manifest": {
      "CommandTimeoutSeconds": 30,
      "MaxRetryCount": 5
    }
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "",
    "DownloadQueueName": "inbound-download",
    "ProcessQueueName": "inbound-process",
    "MaxAutoLockRenewalMinutes": 15
  },
  "Clearinghouses": {
    "Stedi": {
      "Id": 8,
      "Title": "Stedi",
      "Hosts": "stedi-hosts",
      "Port": "stedi-port",
      "UserName": "stedi-username",
      "UserPassword": "stedi-password",
      "DownloadDirectory": "stedi-downloadDirectory",
      "HostKeyFingerprint": ""
    },
    "Availity": {
      "Id": 1,
      "Title": "Availity",
      "Hosts": "availity-hosts",
      "Port": "availity-port",
      "UserName": "availity-username",
      "UserPassword": "availity-password",
      "DownloadDirectory": "availity-downloadDirectory",
      "HostKeyFingerprint": ""
    }
  },
  "InboundDownload": {
    "MaxRunMinutes": 13,
    "BatchConcurrency": 2,
    "SftpPoolSize": 4,
    "ConnectTimeoutSeconds": 30,
    "FailureMessageMaxLength": 500,
    "DeleteRemoteFiles": true,
    "MinimumFileAgeSeconds": 0,
    "SftpRetryCount": 0,
    "SftpRetryBaseDelayMilliseconds": 500
  },
  "KeyVault": {
    "SecretCacheMinutes": 15
  }
}
