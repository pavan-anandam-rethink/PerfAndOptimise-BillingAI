{
  "KeyVaultUri": "https://bai-ch-eus2-dev-kv.vault.azure.net/",
  "Logging": {
    "AppInsightsLogger": {
      "IsEnabled": true,
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Error",
        "System": "Warning",
        "Rethink": "Information"
      }
    }
  },
  "ApplicationInsights": {
    "InstrumentationKey": "Dev--Clearinghouse--ApplicationInsights--InstrumentationKey",
    "APPLICATIONINSIGHTS_CONNECTION_STRING": "Dev--Billing--ApplicationInsights--Connection--String"
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "ApplicationKeySettings": {
      "CheckAcceptedApplicationKeys": false
    }
  },
  "BillingApiUrl": "Dev--Clearinghouse--BillingApiUrl",
  "BillingApiKey": "Dev--Clearinghouse--BillingApiKey",
  "HeaderKey": "x-application-key",
  "ConnectionStrings": {
    "BlobStorage": {
      "ConnectionString": "Dev--Clearinghouse--ConnectionStrings--BlobStorage--ConnectionString"
    }
  },
  "AvailityBackup": "billing-availity-backup",
  "Clearinghouses": {
    "Stedi": {
      "Id": 8,
      "Title": "Stedi",
      "Hosts": "stedi-hosts",
      "Port": "stedi-port",
      "UserName": "stedi-username",
      "UserPassword": "stedi-password",
      "DownloadDirectory": "stedi-downloadDirectory",
      "HostKeyFingerprint": ""
    },
    "Availity": {
      "Id": 1,
      "Title": "Availity",
      "Hosts": "availity-hosts",
      "Port": "availity-port",
      "UserName": "availity-username",
      "UserPassword": "availity-password",
      "DownloadDirectory": "availity-downloadDirectory",
      "HostKeyFingerprint": ""
    }
  },
  "InboundDownload": {
    "MaxRunMinutes": 13,
    "BatchConcurrency": 2,
    "SftpPoolSize": 4,
    "ConnectTimeoutSeconds": 30,
    "FailureMessageMaxLength": 500,
    "DeleteRemoteFiles": true,
    "MinimumFileAgeSeconds": 0,
    "SftpRetryCount": 0,
    "SftpRetryBaseDelayMilliseconds": 500
  },
  "KeyVault": {
    "SecretCacheMinutes": 15
  }
}
